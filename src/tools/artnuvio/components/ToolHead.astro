---
// The ArtNuvio page header: title, one-line pitch and the Editor / Library tabs.
// The tabs are inert until the Library exists (sprint 10); the Editor is the open one.
---

<div class="tool-head hero-aurora">
	<div>
		<p class="eyebrow">Nuvio Tools / 02</p>
		<h1 class="tool-title">
			<span class="text-gradient">ArtNuvio</span>
		</h1>
		<p class="tool-sub">
			Frame art at Nuvio's exact shapes. Every Artwork gets one URL for life,
			and you can swap the image behind it whenever you like.
		</p>
	</div>
	<nav class="tool-tabs" aria-label="ArtNuvio sections">
		<button type="button" class="btn" aria-pressed="true">
			Editor
		</button>
		<button type="button" class="btn" aria-pressed="false">
			Library <span class="tab-count">0</span>
		</button>
	</nav>
</div>
