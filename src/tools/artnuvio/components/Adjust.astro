---
// Fill, Scale and Saved size. In the rail they are three sections; when stacked they
// share one box, with one hint line under Fill and Scale (.adj-hint) instead of the Fill
// hint. Empty state: all disabled. Saved size shows Hero's two sizes, as Hero is picked.
// The file sizes are the mock's estimates until real ones are measured (sprint 05).
import { FRAMES } from '../frames';

const hint = 'Cover fills the whole Frame. Fit shows the whole image.';
const estimate: Record<string, string> = { full: '1.4 MB', standard: '0.5 MB' };
const heroSizes = FRAMES.hero.sizes;
---

<div class="adjust">
	<fieldset class="ctl c-fit is-disabled">
		<legend class="eyebrow">Fill</legend>
		<div class="seg">
			<label>
				<input type="radio" name="mode" value="fit" disabled />
				Fit
			</label>
			<label>
				<input type="radio" name="mode" value="cover" disabled />
				Cover
			</label>
		</div>
		<p class="ctl-hint">{hint}</p>
	</fieldset>

	<div class="ctl c-scale is-disabled">
		<label class="eyebrow ctl-label" for="scale-in">
			Scale{' '}
			<output class="scale-out" for="scale-in">
				–
			</output>
		</label>
		<div class="range-wrap">
			<input
				id="scale-in"
				class="range"
				type="range"
				min="0"
				max="1000"
				step="1"
				value="500"
				style="--fill: 50%"
				disabled
			/>
			<div class="marks" aria-hidden="true">
				<button
					type="button"
					class="mark"
					tabindex="-1"
					style="left: 30%"
					disabled
				>
					Fit
				</button>
				<button
					type="button"
					class="mark"
					tabindex="-1"
					style="left: 50%"
					disabled
				>
					Cover
				</button>
			</div>
		</div>
		<p class="soft" aria-live="polite"></p>
	</div>

	<p class="ctl-hint adj-hint">{hint}</p>

	<fieldset class="ctl c-size is-disabled">
		<legend class="eyebrow">Saved size</legend>
		<div class="size-body">
			<div role="radiogroup" aria-label="Hero size">
				{heroSizes.map((size, i) => (
					<label class="size-opt">
						<input
							type="radio"
							name="hero-size"
							value={size.key}
							checked={i === 0}
							disabled
						/>
						<span class="font-mono">
							{size.width}×{size.height}
						</span>
						<span class="text-muted">{estimate[size.key]}</span>
					</label>
				))}
			</div>
			<p class="ctl-hint">
				{heroSizes[0].width}×{heroSizes[0].height} is offered when the Original
				is big enough.
			</p>
		</div>
	</fieldset>
</div>
