---
// Name, Save and the folder's four Frames. Empty shell: the name and Save are disabled,
// and every Frame shows as empty until a Name can be typed.
import { FRAME_IDS, FRAMES } from '../frames';
---

<section class="ed-save" aria-label="Name and save">
	<label class="eyebrow" for="artwork-name">
		Name <span class="hint-optional">the Nuvio folder it's for</span>
	</label>
	<div class="save-row">
		<input
			id="artwork-name"
			type="text"
			autocomplete="off"
			placeholder="e.g. Serial Killer movies"
			disabled
		/>
		<button type="button" class="btn" disabled>
			Save Hero
		</button>
	</div>
</section>

<section class="ed-set" aria-label="Folder set">
	<p class="set-head">
		<span class="eyebrow">Folder set</span>
		<span class="hint-optional">
			Type a Name to see which Frames that folder already has.
		</span>
	</p>
	<ul class="set-slots">
		{FRAME_IDS.map((id) => (
			<li class="set-slot">
				<span class="set-slot-name">{FRAMES[id].label}</span>
				<span class="set-slot-state">Empty</span>
			</li>
		))}
	</ul>
</section>
