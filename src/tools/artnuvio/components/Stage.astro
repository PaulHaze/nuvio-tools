---
// The preview. Empty state: the whole stage is the drop zone, with one paste box as the
// obvious start. The caption names the picked Frame (Hero by default).
// No behaviour yet: loading an Original arrives in sprints 03 and 07.
import { Icon } from 'astro-icon/components';
import { FRAME_IDS, FRAMES } from '../frames';
import Glyph from './Glyph.astro';

const frame = FRAME_IDS[0];
const { label, aspect, sizes } = FRAMES[frame];
const caption = `${label} · ${aspect.width}:${aspect.height} · saves ${sizes[0].width}×${sizes[0].height}`;
---

<div class="stage" data-has="0">
	<div class="stage-cap">
		<span class="cap-left">
			<Glyph frame={frame} size={13} />
			<span>{caption}</span>
		</span>
		<span class="cap-right"></span>
	</div>
	<div class="drop">
		<div class="drop-inner">
			<span class="drop-icon">
				<Icon name="lucide:image" />
			</span>
			<h2 class="drop-title">Start with an Original</h2>
			<p class="drop-lead">
				Paste an image, or a link to one. Either works in the same box.
			</p>
			<form class="paste-row" onsubmit="return false" novalidate>
				<input
					type="text"
					inputmode="url"
					autocomplete="off"
					spellcheck="false"
					aria-label="Image URL, or paste an image"
					placeholder="Paste here (⌘V): an image, or https://…"
				/>
				<button type="submit" class="btn">
					Load
				</button>
			</form>
			<div class="drop-or">
				<span>or</span>
			</div>
			<div class="drop-file">
				<button type="button" class="btn btn-ghost btn-sm">
					<Icon name="lucide:upload" />
					Choose a file
				</button>
				<span class="drop-anywhere text-muted">
					or drop one anywhere on this page
				</span>
			</div>
		</div>
	</div>
</div>
