---
// The Original bar under the preview. Empty state: nothing to show, so the edge toggle
// and New Original are disabled.
import { Icon } from 'astro-icon/components';
---

<div class="orig-bar">
	<span class="orig-thumb">
		<Icon name="lucide:image" />
	</span>
	<div class="orig-meta">
		<span class="orig-name">No Original yet</span>
		<span class="orig-dims">Paste (⌘V), drop, or choose an image</span>
	</div>
	<label class="check">
		<input type="checkbox" disabled /> Show cropped edges
	</label>
	<button type="button" class="btn btn-ghost btn-sm" disabled>
		New Original
	</button>
</div>
