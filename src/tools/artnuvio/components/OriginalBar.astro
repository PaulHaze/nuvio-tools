---
// The Original bar under the preview. Empty shell: nothing to show or change yet.
---

<div class="ed-orig">
	<span class="orig-thumb" aria-hidden="true"></span>
	<div class="orig-meta">
		<span class="orig-name">No Original yet</span>
		<span class="orig-dims eyebrow">Paste, drop or choose an image</span>
	</div>
	<label class="orig-check">
		<input type="checkbox" disabled />
		<span>Show cropped edges</span>
	</label>
	<button type="button" class="btn btn-ghost" disabled>
		New Original
	</button>
</div>
