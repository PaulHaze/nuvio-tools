---
import { env } from 'cloudflare:workers';
import Layout from '@/lib/ui/Layout.astro';
import { getIndex } from '@/tools/listio/storage/lists';
import { resolveAddonId } from '@/tools/listio/domain/addonId';
import ExportCollection from '@/tools/listio/components/export/ExportCollection';
export const prerender = false;
const lists = await getIndex(env.LISTIO);
---

<Layout title="Export collection · Listio">
	<main class="listio-main">
		<a href="/listio">← Combined Lists</a>
		<header class="page-heading">
			<h1>Export collection</h1>
			<p>
				Download one Nuvio collection with a folder for each chosen Combined
				List.
			</p>
		</header>
		<ExportCollection
			client:load
			lists={lists}
			addonId={resolveAddonId(env.ADDON_ID)}
			initialSelected={Astro.url.searchParams.getAll('list')}
			initialName={Astro.url.searchParams.get('name') ?? ''}
		/>
	</main>
</Layout>
