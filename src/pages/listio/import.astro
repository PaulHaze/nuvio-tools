---
import { env } from 'cloudflare:workers';
import Layout from '@/lib/ui/Layout.astro';
import '@/tools/listio/listio.css';
import { getIndex } from '@/tools/listio/storage/lists';
import { resolveAddonId } from '@/tools/listio/domain/addonId';
import ImportFromText from '@/tools/listio/components/import/ImportFromText';
export const prerender = false;
const lists = await getIndex(env.LISTIO);
const initialCollection = Astro.url.searchParams.get('collection');
const collectionMode = initialCollection !== null;
const multipleMode = Astro.url.searchParams.get('mode') === 'multiple';
const heading = collectionMode
	? 'New collection'
	: multipleMode
		? 'Multiple Lists'
		: 'Import from text';
---

<Layout title={`${heading} · Listio`} tool="listio">
	<main class="listio-main">
		<a href="/listio">← Combined Lists</a>
		<header class="page-heading hero-aurora">
			<h1>{heading}</h1>
			<p>
				{collectionMode
					? 'Paste sectioned lists to save one Combined List per header and download a Nuvio collection.'
					: multipleMode
						? 'Paste titles under ## headings. Each heading becomes a saved Combined List on the home page.'
						: 'Create one saved Combined List from movie and TV titles.'}
			</p>
		</header>
		<ImportFromText
			client:load
			initialLists={lists}
			initialMode={multipleMode ? 'multiple' : 'single'}
			initialCollection={initialCollection}
			addonId={resolveAddonId(env.ADDON_ID)}
		/>
	</main>
</Layout>
