---
import Layout from '@/lib/ui/Layout.astro';
import '@/styles/artnuvio/index.css';
import ToolHead from '@/tools/artnuvio/components/ToolHead.astro';
import Editor from '@/tools/artnuvio/components/Editor.tsx';

export const prerender = false;
---

<Layout
	title="ArtNuvio · Nuvio Tools"
	description="ArtNuvio frames art at Nuvio's exact shapes and hosts it at a permanent URL."
	tool="artnuvio"
>
	<main class="artnuvio-main">
		<ToolHead />
		<Editor client:load />
	</main>
</Layout>
