---
import Layout from '@/lib/ui/Layout.astro';

export const prerender = false;
---

<Layout
	title="Collectio · Nuvio Tools"
	description="Collectio is coming soon."
	tool="collectio"
>
	<main class="shell-main">
		<section class="hero-aurora shell-hero">
			<p class="eyebrow">Collectio / Coming soon</p>
			<h1>
				<span class="text-gradient">Collectio</span>
			</h1>
			<p class="hero-copy">Coming soon.</p>
			<div class="hero-actions">
				<a class="btn btn-ghost" href="/">
					← Back to Nuvio Tools
				</a>
			</div>
		</section>
	</main>
</Layout>
