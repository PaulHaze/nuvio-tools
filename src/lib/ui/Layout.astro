---
import { Font } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';
import '@/lib/ui/main.css';

interface Props {
	title: string;
	description?: string;
	/** Social share image: a path under public/ or an absolute URL. */
	image?: string;
	tool?: 'listio' | 'artnuvio' | 'collectio';
}

const {
	title,
	description = 'Tools for Nuvio: lists, artwork and collections.',
	image,
	tool,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.url.origin);
const imageURL = image ? new URL(image, Astro.url.origin) : undefined;
---

<!doctype html>
<html lang="en" data-page={tool ?? 'home'}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<meta name="color-scheme" content="dark" />

		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalURL} />

		<!-- Open Graph / social sharing -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		{imageURL && <meta property="og:image" content={imageURL} />}
		<meta
			name="twitter:card"
			content={imageURL ? 'summary_large_image' : 'summary'}
		/>

		<Font cssVariable="--font-inter" preload />
		<Font cssVariable="--font-outfit" preload />
		<Font cssVariable="--font-geist-mono" />

		<ClientRouter />
	</head>
	<body class="relative">
		<header class="brand-header">
			<div class="brand-header-inner">
				<a class="wordmark" href="/" aria-label="Nuvio Tools home">
					<span class="brand-icon" aria-hidden="true">
						n
					</span>
					<span class="text-gradient">Nuvio Tools</span>
				</a>
				<nav aria-label="Tools">
					<a
						href="/listio"
						aria-current={tool === 'listio' ? 'page' : undefined}
					>
						Listio
					</a>
					<a
						href="/artnuvio"
						aria-current={tool === 'artnuvio' ? 'page' : undefined}
					>
						ArtNuvio
					</a>
					<a
						href="/collectio"
						aria-current={tool === 'collectio' ? 'page' : undefined}
					>
						Collectio
					</a>
				</nav>
			</div>
		</header>
		<div class="site-body" data-tool={tool}>
			<slot />
			<footer class="site-credits" aria-label="Credits">
				<h2 class="eyebrow">Credits</h2>
				<a href="https://www.themoviedb.org">
					<img
						src="/tmdb-logo.svg"
						alt="The Movie Database (TMDB)"
						width="80"
						height="10"
					/>
				</a>
				<p>
					This product uses the TMDB API but is not endorsed or certified by
					TMDB.
				</p>
			</footer>
		</div>
	</body>
</html>
